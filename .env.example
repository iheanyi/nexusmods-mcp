# Optional standalone catalogue mode; omit to reuse the Vortex bridge.
# NEXUS_API_KEY=
# Overrides for portable/custom Vortex data directories:
# VORTEX_BRIDGE_FILE=C:/path/to/Vortex/nexusmods-mcp/bridge.json
# HTTP transport only (stdio is the default):
# MCP_HTTP_TOKEN=generate-a-random-secret-of-at-least-32-characters
# MCP_PORT=7331
